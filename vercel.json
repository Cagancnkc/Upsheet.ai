{
  "version": 2,
  "buildCommand": "",
  "outputDirectory": ".",
  "installCommand": "npm install",
  "framework": null,
  "headers": [
    {
      "source": "/(.*\\.html|)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/:path+.(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://unpkg.com https://www.clarity.ms https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://*.supabase.co https://api.anthropic.com https://*.vercel.app https://mocksheets.com https://www.mocksheets.com https://upsheet-ai.onrender.com https://*.clarity.ms https://www.google-analytics.com https://region1.google-analytics.com; img-src 'self' data: blob: https://cdn.simpleicons.org https://svgl.app; frame-ancestors 'none';" }
      ]
    }
  ],
  "cleanUrls": true,
  "rewrites": [
    { "source": "/favicon.ico", "destination": "/images/favicon.png" },
    { "source": "/app", "destination": "/app.html" },
    { "source": "/auth", "destination": "/auth.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/blog", "destination": "/blog.html" },
    { "source": "/kvkk", "destination": "/kvkk.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/similarweb-analytics", "destination": "/similarweb-analytics.html" },
    { "source": "/dashboard", "destination": "/app.html" },
    { "source": "/integrations", "destination": "/automations.html" },
    { "source": "/payment-success", "destination": "/payment-success.html" },
    { "source": "/automations", "destination": "/automations.html" },
    { "source": "/en", "destination": "/en.html" },
    { "source": "/mock-data-generator", "destination": "/mock-data-generator.html" },
    { "source": "/fake-data-generator", "destination": "/fake-data-generator.html" },
    { "source": "/ai-spreadsheet-generator", "destination": "/ai-spreadsheet-generator.html" },
    { "source": "/csv-generator", "destination": "/csv-generator.html" },
    { "source": "/test-data-generator", "destination": "/test-data-generator.html" },
    { "source": "/excel-mock-data", "destination": "/excel-mock-data.html" },
    { "source": "/blog/:slug", "destination": "/blog/:slug.html" },
    { "source": "/takim", "destination": "/takim.html" },
    { "source": "/(.*)", "destination": "/404.html" }
  ]
}
