{
  "version": 2,
  "buildCommand": "",
  "outputDirectory": ".",
  "installCommand": "npm install",
  "framework": null,
  "headers": [
    {
      "source": "/(.*\\.html|)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/:path+.(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://unpkg.com https://cdnjs.cloudflare.com https://www.clarity.ms https://scripts.clarity.ms https://www.googletagmanager.com https://www.google-analytics.com https://a.plerdy.com https://localizercdn.com https://secure.localizer.co; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://unpkg.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com https://unpkg.com; connect-src 'self' https://*.supabase.co https://api.anthropic.com https://*.vercel.app https://mocksheets.com https://www.mocksheets.com https://upsheet-ai.onrender.com https://*.clarity.ms https://www.google-analytics.com https://region1.google-analytics.com https://cdnjs.cloudflare.com https://unpkg.com https://a.plerdy.com https://localizercdn.com https://*.localizercdn.com; img-src 'self' data: blob: https://cdn.simpleicons.org https://svgl.app https://cdn.jsdelivr.net https://upload.wikimedia.org https://www.google-analytics.com https://www.googletagmanager.com; frame-ancestors 'none';" }
      ]
    }
  ],
  "cleanUrls": true,
  "redirects": [
    { "source": "/hakkimizda", "destination": "/about", "permanent": true },
    { "source": "/iletisim", "destination": "/contact", "permanent": true },
    { "source": "/gizlilik", "destination": "/privacy", "permanent": true },
    { "source": "/kullanim-kosullari", "destination": "/terms", "permanent": true },
    { "source": "/mock-data-generator", "destination": "/", "permanent": true },
    { "source": "/fake-data-generator", "destination": "/", "permanent": true },
    { "source": "/ai-spreadsheet-generator", "destination": "/", "permanent": true },
    { "source": "/csv-generator", "destination": "/", "permanent": true },
    { "source": "/test-data-generator", "destination": "/", "permanent": true },
    { "source": "/excel-mock-data", "destination": "/", "permanent": true },
    { "source": "/blog/kdv-hesaplama", "destination": "/blog", "permanent": true },
    { "source": "/blog/excel-veri-temizleme", "destination": "/blog", "permanent": true },
    { "source": "/blog/aylik-satis-raporu", "destination": "/blog", "permanent": true },
    { "source": "/blog/net-maas-hesaplama", "destination": "/blog", "permanent": true },
    { "source": "/karsilastirma/mocksheets-vs-copilot", "destination": "/", "permanent": true },
    { "source": "/karsilastirma/mocksheets-vs-chatgpt", "destination": "/", "permanent": true },
    { "source": "/karsilastirma/mocksheets-vs-formula-bot", "destination": "/", "permanent": true },
    { "source": "/karsilastirma", "destination": "/", "permanent": true },
    { "source": "/karsilastirma/:slug", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/favicon.ico", "destination": "/images/favicon.png" },
    { "source": "/app", "destination": "/app.html" },
    { "source": "/auth", "destination": "/auth.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/pricing", "destination": "/pricing.html" },
    { "source": "/blog", "destination": "/blog.html" },
    { "source": "/kvkk", "destination": "/kvkk.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/similarweb-analytics", "destination": "/similarweb-analytics.html" },
    { "source": "/dashboard", "destination": "/app.html" },
    { "source": "/integrations", "destination": "/automations.html" },
    { "source": "/payment-success", "destination": "/payment-success.html" },
    { "source": "/automations", "destination": "/automations.html" },
    { "source": "/en", "destination": "/en.html" },
    { "source": "/blog/:slug", "destination": "/blog/:slug.html" },
    { "source": "/takim", "destination": "/takim.html" },
    { "source": "/shopify-seo-otomasyonu", "destination": "/shopify-seo-otomasyonu.html" },
    { "source": "/shopify-toplu-urun-aciklamasi", "destination": "/shopify-toplu-urun-aciklamasi.html" },
    { "source": "/shopify-katalog-saglik-skoru", "destination": "/shopify-katalog-saglik-skoru.html" },
    { "source": "/mocksheets-vs-smart-seo", "destination": "/mocksheets-vs-smart-seo.html" },
    { "source": "/mocksheets-vs-yoast-seo-shopify", "destination": "/mocksheets-vs-yoast-seo-shopify.html" },
    { "source": "/mocksheets-vs-ai-seo-audit", "destination": "/mocksheets-vs-ai-seo-audit.html" },
    { "source": "/mocksheets-vs-catalog-health-pro", "destination": "/mocksheets-vs-catalog-health-pro.html" },
    { "source": "/degisiklikler", "destination": "/degisiklikler.html" },
    { "source": "/shopify-cok-dilli-urun-cevirisi", "destination": "/shopify-cok-dilli-urun-cevirisi.html" },
    { "source": "/shopify-duplicate-urun-duzeltme", "destination": "/shopify-duplicate-urun-duzeltme.html" },
    { "source": "/shopify-vendor-marka-standardizasyonu", "destination": "/shopify-vendor-marka-standardizasyonu.html" },
    { "source": "/(.*)", "destination": "/404.html" }
  ]
}
